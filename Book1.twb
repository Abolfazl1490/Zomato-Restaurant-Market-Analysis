      <column caption='Rating Band' datatype='string' name='[Calculation_1007207938613252]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([rating cleaning2]) THEN &quot;Not Rated&quot;&#13;&#10;ELSEIF [rating cleaning2] &lt; 2 THEN &quot;Below 2&quot;&#13;&#10;ELSEIF [rating cleaning2] &lt; 3 THEN &quot;2 to 2.9&quot;&#13;&#10;ELSEIF [rating cleaning2] &lt; 4 THEN &quot;3 to 3.9&quot;&#13;&#10;ELSE &quot;4 and above&quot;&#13;&#10;END' />
      </column>
      <column caption='Online Order Status' datatype='string' name='[Calculation_1007207939645445]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF UPPER(TRIM([online_order_Clean2]))= &quot;YES&quot;&#13;&#10;THEN &quot;Oniline Avilable&quot;&#13;&#10;ELSEIF UPPER(TRIM([online_order_Clean2]))=&quot;NO&quot;&#13;&#10;then &quot;Oniline Not Avilable&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Avrage Votes per record' datatype='real' name='[Calculation_1007207940694022]' role='measure' type='quantitative'>
