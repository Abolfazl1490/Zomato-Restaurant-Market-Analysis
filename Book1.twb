    <worksheet name='Online Order Analysis'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#00007f' fontname='Arial' fontsize='10'>Restaurant Count &amp; Average Rating by Online Order</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='zomato (Book1)' name='federated.0umuhgp0r34d4u15bornu1xeb40z' />
          </datasources>
          <datasource-dependencies datasource='federated.0umuhgp0r34d4u15bornu1xeb40z'>
            <column caption='Avrage Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1007207938134018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([rating cleaning2])' />
            </column>
            <column caption='Rating Band' datatype='string' name='[Calculation_1007207938613252]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([rating cleaning2]) THEN &quot;Not Rated&quot;&#13;&#10;ELSEIF [rating cleaning2] &lt; 2 THEN &quot;Below 2&quot;&#13;&#10;ELSEIF [rating cleaning2] &lt; 3 THEN &quot;2 to 2.9&quot;&#13;&#10;ELSEIF [rating cleaning2] &lt; 4 THEN &quot;3 to 3.9&quot;&#13;&#10;ELSE &quot;4 and above&quot;&#13;&#10;END' />
            </column>
            <column caption='Online Order Status' datatype='string' name='[Calculation_1007207939645445]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF UPPER(TRIM([online_order_Clean2]))= &quot;YES&quot;&#13;&#10;THEN &quot;Oniline Avilable&quot;&#13;&#10;ELSEIF UPPER(TRIM([online_order_Clean2]))=&quot;NO&quot;&#13;&#10;then &quot;Oniline Not Avilable&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
            </column>
            <column aggregation='None' caption='Rating Cleaning2 (bin)' datatype='integer' name='[Rating Cleaning2 (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='-1' formula='[rating cleaning2]' peg='0' size='0.5' />
            </column>
            <column caption='Votes clean2' datatype='integer' default-format='n#,##0,.00K;-#,##0,.00K' name='[Votes_clean2]' role='measure' type='quantitative' />
            <column-instance column='[name]' derivation='Count' name='[cnt:name:qk]' pivot='key' type='quantitative' />
            <column caption='Cuisines' datatype='string' name='[cuisines]' role='dimension' type='nominal' />
            <column caption='Location' datatype='string' name='[location]' role='dimension' type='nominal' />
            <column caption='Name' datatype='string' name='[name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1007207939645445]' derivation='None' name='[none:Calculation_1007207939645445:nk]' pivot='key' type='nominal' />
            <column caption='online order Clean2' datatype='string' name='[online_order_Clean2]' role='dimension' type='nominal' />
            <column caption='Rating Cleaning2' datatype='real' name='[rating cleaning2]' role='measure' type='quantitative' />
            <column-instance column='[Votes_clean2]' derivation='Sum' name='[sum:Votes_clean2:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1007207938134018]' derivation='User' name='[usr:Calculation_1007207938134018:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0umuhgp0r34d4u15bornu1xeb40z].[Action (Cuisines)]'>
            <groupfilter function='level-members' level='[cuisines]' user:ui-action-filter='[Action4_5CFACD6F2BA34A75945AD484428B5454]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0umuhgp0r34d4u15bornu1xeb40z].[Action (Location)]'>
            <groupfilter function='level-members' level='[location]' user:ui-action-filter='[Action4_45B81B9760D942E8A471662B010F2AF7]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0umuhgp0r34d4u15bornu1xeb40z].[Action (Rating Band,Rating Cleaning2 (bin))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action1_815872E75BB04E17B7ACC8662852CA48]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_1007207938613252]' />
              <groupfilter function='level-members' level='[Rating Cleaning2 (bin)]' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0umuhgp0r34d4u15bornu1xeb40z].[Action (Location)]</column>
            <column>[federated.0umuhgp0r34d4u15bornu1xeb40z].[Action (Cuisines)]</column>
            <column>[federated.0umuhgp0r34d4u15bornu1xeb40z].[Action (Rating Band,Rating Cleaning2 (bin))]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' field='[federated.0umuhgp0r34d4u15bornu1xeb40z].[none:Calculation_1007207939645445:nk]' value='177' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <lod column='[federated.0umuhgp0r34d4u15bornu1xeb40z].[sum:Votes_clean2:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minwidth' value='-1' />
                <format attr='maxwidth' value='-1' />
              </style-rule>
            </style>
          </pane>
          <pane id='1' selection-relaxation-option='selection-relaxation-allow' y-axis-name='[federated.0umuhgp0r34d4u15bornu1xeb40z].[cnt:name:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <lod column='[federated.0umuhgp0r34d4u15bornu1xeb40z].[sum:Votes_clean2:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
          <pane id='2' selection-relaxation-option='selection-relaxation-allow' y-axis-name='[federated.0umuhgp0r34d4u15bornu1xeb40z].[usr:Calculation_1007207938134018:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <lod column='[federated.0umuhgp0r34d4u15bornu1xeb40z].[sum:Votes_clean2:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([federated.0umuhgp0r34d4u15bornu1xeb40z].[cnt:name:qk] + [federated.0umuhgp0r34d4u15bornu1xeb40z].[usr:Calculation_1007207938134018:qk])</rows>
        <cols>([federated.0umuhgp0r34d4u15bornu1xeb40z].[none:Calculation_1007207939645445:nk] / [federated.0umuhgp0r34d4u15bornu1xeb40z].[none:Calculation_1007207939645445:nk])</cols>
      </table>
